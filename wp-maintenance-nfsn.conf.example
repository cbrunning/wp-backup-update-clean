# NFSN hosting configuration example
# Recommended location:
#   /home/private/wp-maintenance.conf

DOMAIN="yourdomain.example.com"
WP_ROOT="/home/public"
PRIVATE_BASE="/home/private"

TMP_DIR="${TMP_DIR:-/home/tmp/backups}"
BACKUP_DIR="${BACKUP_DIR:-$PRIVATE_BASE/wordpress-maintenance-backups}"
LOG_DIR="${LOG_DIR:-$PRIVATE_BASE/logs}"
MAINT_LOG="${MAINT_LOG:-$LOG_DIR/wp-maintenance.log}"
WP_CLI_CACHE="${WP_CLI_CACHE:-$WP_ROOT/.wp-cli/cache}"

# Disk space usage can be limited
RETENTION_BACKUPS="${RETENTION_BACKUPS:-108}" # days to keep backups; consider keeping this lower if you regularly copy backups to external storage
RETENTION_LOGS="${RETENTION_LOGS:-540}"       # days to keep logs
RETENTION_WPCLI="${RETENTION_WPCLI:-90}"      # days to keep WP-CLI caches (e.g. older plugin and theme packages)

# Path to your site update script
UPDATE_SCRIPT="${UPDATE_SCRIPT:-/usr/local/bin/wp-update.sh}"
# Example:
# UPDATE_SCRIPT="${UPDATE_SCRIPT:-/path/to/update-site.sh"

